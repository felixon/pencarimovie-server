{
    skip_install_trust

    {$CADDY_GLOBAL_OPTIONS}

    frankenphp {
        {$FRANKENPHP_CONFIG}
    }
}

{$CADDY_EXTRA_CONFIG}

# Render's entrypoint sets SERVER_NAME to http://:<PORT>.
# Using the SERVER_NAME variable follows the official FrankenPHP Docker
# configuration and disables automatic HTTPS for Render's internal HTTP port.
{$SERVER_NAME:localhost} {
    root * /app
    encode zstd br gzip

    php_server {
        index index.php
    }

    file_server
}

import Caddyfile.d/*.caddyfile
