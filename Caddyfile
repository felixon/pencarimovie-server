{ # FrankenPHP uses Caddy under the hood. # This Caddyfile is based on the official FrankenPHP template.

    skip_install_trust

    {$CADDY_GLOBAL_OPTIONS}

    frankenphp {
        {$FRANKENPHP_CONFIG}
    }

}

{$CADDY_EXTRA_CONFIG}

# Render supplies PORT (normally 10000). Fall back to 8088 for local use.
:{$PORT:8088} {
    root * .
    encode zstd br gzip

    php_server {
        index index.php
    }

    file_server
}

import Caddyfile.d/*.caddyfile
